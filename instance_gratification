/**
 * Gratifier.java
 *
 * Simple utility that prints a randomized "congrats/affirmation" message
 * when an instance is created. Safe for multi-threaded use and lets you
 * add custom messages at runtime.
 */
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;
import java.util.concurrent.ThreadLocalRandom;

public class Gratifier {
    private static final List<String> messages = new CopyOnWriteArrayList<>();

    static {
        // Default messages — feel free to edit or add via addMessage(...)
        messages.add("Nice! You're doing great — keep going ✨");
        messages.add("An instance was born — more awesome code incoming 🚀");
        messages.add("Well done! That object is ready to shine 💪");
        messages.add("Another milestone! Small wins add up 🎉");
        messages.add("Code + care = progress. That instance proves it ❤️");
        messages.add("You instantiated brilliance. Carry on! 🌟");
        messages.add("Tiny object, big potential — excellent move 👏");
    }

    private final String label;

    public Gratifier() {
        this("Instance");
    }

    public Gratifier(String label) {
        this.label = label == null || label.isEmpty() ? "Instance" : label;
        celebrateCreation();
    }

    // Prints a single random celebratory message (on creation)
    private void celebrateCreation() {
        String msg = pickRandomMessage();
        System.out.println(format(label, msg));
    }

    // Can be called by client code to re-run a celebration
    public void celebrate() {
        String msg = pickRandomMessage();
        System.out.println(format(label, msg));
    }

    // Returns the currently selected message (without printing)
    public String getCurrentGratification() {
        return pickRandomMessage();
    }

    // Add a custom message at runtime. Message inserted to front for immediate visibility.
    public static void addMessage(String message) {
        if (message == null || message.trim().isEmpty()) return;
        messages.add(0, message.trim());
    }

    // Remove a message (first matching). Returns true if removed.
    public static boolean removeMessage(String message) {
        return messages.remove(message);
    }

    // Get snapshot of all messages
    public static List<String> getMessages() {
        return List.copyOf(messages);
    }

    private static String pickRandomMessage() {
        int i = ThreadLocalRandom.current().nextInt(messages.size());
        return messages.get(i);
    }

    private static String format(String label, String message) {
        return String.format("[Gratifier] %s — %s", label, message);
    }

    @Override
    public String toString() {
        return String.format("Gratifier(%s)", label);
    }
}